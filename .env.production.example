# =============================================================================
# Contoh konfigurasi PRODUKSI — SPMB Yayasan Al-Ishlah Insan Mulia
# =============================================================================
# Salin berkas ini menjadi `.env` di server, lalu isi semua nilai.
# JANGAN memakai berkas ini apa adanya. Jangan pernah mengunggah `.env` ke
# repositori, grup WhatsApp, atau folder publik.
#
# Setelah `.env` terisi:
#   php artisan key:generate --force
#   php artisan spmb:periksa-produksi
#
# Berkas ini sengaja tanpa nilai rahasia (kata sandi, kunci, token).
# =============================================================================

# --- Identitas aplikasi ------------------------------------------------------
APP_NAME="SPMB Al-Ishlah Insan Mulia"
# WAJIB production. Aplikasi menolak berjalan bila APP_ENV=production tetapi
# APP_DEBUG=true atau APP_KEY kosong (K-11).
APP_ENV=production
# Diisi oleh `php artisan key:generate`. Tanpa kunci ini NIK terenkripsi dan
# sesi tidak dapat dibuka. Simpan salinannya TERPISAH dari server dan cadangan.
APP_KEY=
# WAJIB false di produksi. Jejak galat tidak boleh tampil ke pengguna.
APP_DEBUG=false
# WAJIB https. Semua tautan, cookie, dan pengalihan memakai alamat ini.
APP_URL=https://spmb.contoh.sch.id

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# --- Log ---------------------------------------------------------------------
# `warning` di produksi: galat penting tetap tercatat, percakapan rutin tidak.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# --- Basis data (MySQL 8) ----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppdb_alinsan
DB_USERNAME=ppdb_user
DB_PASSWORD=

# --- Sesi dan cookie ---------------------------------------------------------
# Sesi disimpan di tabel `sessions` agar bisa dicabut saat kata sandi diganti.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
# Isi domain tanpa skema (contoh: spmb.contoh.sch.id). `null` = domain saat ini.
SESSION_DOMAIN=null
# WAJIB true: cookie hanya dikirim lewat HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Antrean dan cache -------------------------------------------------------
# Antrean memakai tabel `jobs`; jalankan worker lewat cron/Supervisor.
QUEUE_CONNECTION=database
# Cache memakai tabel `cache`; dipakai juga untuk kunci nomor peserta.
CACHE_STORE=database
# CACHE_PREFIX=

# --- Berkas ------------------------------------------------------------------
# Disk `local` menyimpan berkas privat (storage/app/private), di luar docroot.
FILESYSTEM_DISK=local

# --- Email (SMTP) ------------------------------------------------------------
# Reset kata sandi mandiri hanya berfungsi bila SMTP aktif. Bila tidak, panitia
# mengatur ulang kata sandi secara manual.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.contoh.sch.id
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="spmb@contoh.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cadangan terenkripsi (K-13) --------------------------------------------
# Sandi enkripsi arsip cadangan. WAJIB diisi, panjang minimal 32 karakter acak,
# dan disimpan TERPISAH dari server serta dari arsip cadangan. Tanpa kunci ini
# arsip cadangan tidak dapat dipulihkan.
CADANGAN_KUNCI=
# Lokasi perintah mysql bila tidak ada di PATH.
# SPMB_MYSQLDUMP=/usr/bin/mysqldump
# SPMB_MYSQL=/usr/bin/mysql

# --- Proksi tepercaya --------------------------------------------------------
# Isi HANYA alamat IP proksi (pisahkan koma) bila aplikasi di belakang Nginx,
# Cloudflare, atau load balancer. JANGAN memakai `*`, karena alamat IP pengguna
# bisa dipalsukan dan pembatasan laju masuk menjadi tidak berguna.
TRUSTED_PROXIES=

# --- Batas unggah berkas (KB) -----------------------------------------------
# Harus sejalan dengan upload_max_filesize/post_max_size di php.ini.
SPMB_BERKAS_MAKS_KB=2048
SPMB_KONTEN_MAKS_KB=2048

# --- Vite (hanya bila membangun aset di server) ------------------------------
VITE_APP_NAME="${APP_NAME}"
